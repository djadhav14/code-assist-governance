# Settings for deploy/aws/docker-compose.test-server.yml. No secrets in this file:
# GOV_API_TOKEN and GOV_HASH_KEY live in AWS Secrets Manager.

# Secret name or ARN; its value is {"GOV_API_TOKEN": "...", "GOV_HASH_KEY": "..."}
GOV_AWS_SECRET_ID=ai-governance/test
GOV_AWS_REGION=ap-south-1

# Host name the hooks use (must resolve to this instance)
GOV_SITE_ADDRESS=governance-test.corp.internal

# token | token+oidc | oidc  (docs/ide-hooks.md, section 5)
GOV_AUTH_MODE=token
# For token+oidc / oidc with Microsoft Entra ID (v2.0 access tokens):
# GOV_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# GOV_OIDC_AUDIENCE=<application (client) ID of the governance API registration>
# GOV_OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# GOV_IDENTITY_MISMATCH=log

GOV_NLP_MODEL=en_core_web_lg
GOV_WORKERS=2
# Run as the instance's user so the containers can write ./logs (id -u / id -g)
GOV_UID=1000
GOV_GID=1000
# Pin image tags you have checked on Docker Hub
OTEL_COLLECTOR_TAG=latest
CADDY_TAG=2
