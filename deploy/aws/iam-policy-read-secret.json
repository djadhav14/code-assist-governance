{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadGovernanceSecretOnly",
      "Effect": "Allow",
      "Action": "secretsmanager:GetSecretValue",
      "Resource": "arn:aws:secretsmanager:<region>:<account-id>:secret:ai-governance/<environment>-*"
    },
    {
      "Sid": "DecryptWithTheSecretsKeyOnlyThroughSecretsManager",
      "Effect": "Allow",
      "Action": "kms:Decrypt",
      "Resource": "arn:aws:kms:<region>:<account-id>:key/<key-id>",
      "Condition": {
        "StringEquals": { "kms:ViaService": "secretsmanager.<region>.amazonaws.com" }
      }
    }
  ]
}
