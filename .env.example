# Non-secret configuration for the AI Governance server (docker compose and local runs).
# Copy to .env, or run:  python scripts/init_secrets.py
# Secrets (API token, hash key) do NOT go here: they live in ./secrets/ (see docs/configuration.md).

# --- Server ---
GOV_ENVIRONMENT=local
# port inside the container / process
GOV_PORT=8088
GOV_WORKERS=2
GOV_LOG_LEVEL=info
# en_core_web_sm for laptops with <= 8 GB RAM
GOV_NLP_MODEL=en_core_web_lg
GOV_CHUNK_CHARS=100000
GOV_MAX_TEXT_CHARS=2000000
GOV_MAX_PDF_OCR_PAGES=10
GOV_CACHE_SIZE=4096
OTEL_SERVICE_NAME=ai-governance-detection
# local development only: disables the API token check
# GOV_AUTH_DISABLED=true

# Flat JSON audit file (one decision per line) for Wazuh or another log shipper.
# Used when the server runs without Docker; relative paths resolve against this
# file's folder. With Docker it is always ./logs/governance-decisions.jsonl.
GOV_AUDIT_FILE=./logs/governance-decisions.jsonl

# Detection rules (custom recognizers) and the archive of every version the server
# accepted. Without Docker; relative paths resolve against this file's folder.
# With Docker: ./detection_api/rules/recognizers.json and ./logs/rules-archive.
# GOV_RECOGNIZERS_PATH=./detection_api/rules/recognizers.json
GOV_RULES_ARCHIVE_DIR=./logs/rules-archive

# --- docker compose publishing ---
# 0.0.0.0 only behind a firewall/TLS proxy
GOV_BIND_ADDRESS=127.0.0.1
GOV_PUBLISH_PORT=8088
GOV_SECRETS_DIR=./secrets
# GOV_POLICY_FILE=./detection_api/policy.yaml
# Folder holding recognizers.json, mounted read-only into the container
# GOV_RULES_DIR=./detection_api/rules
# GOV_EVENT_LOG_DIR=./logs
# GOV_UID / GOV_GID are appended by scripts/init_secrets.py on Linux/macOS (your user id),
# so the OTel Collector container can write into ./logs. Not needed on Windows.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318

# --- Clients: hooks, tests and running the server outside Docker ---
# The URL clients use to reach the server. Not a secret.
GOV_API_URL=http://127.0.0.1:8088
# For running the server outside Docker (python -m app.serve), point at the secret files:
GOV_API_TOKEN_FILE=./secrets/gov_api_token
GOV_HASH_KEY_FILE=./secrets/gov_hash_key

# --- Verified user identity (production). See docs/ide-hooks.md, section 5.
# GOV_AUTH_MODE=token
# GOV_OIDC_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
# GOV_OIDC_AUDIENCE=<application-client-id>
# GOV_OIDC_JWKS_URL=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
# GOV_IDENTITY_MISMATCH=log

# --- AWS Secrets Manager instead of ./secrets (test server, production).
# GOV_AWS_SECRET_ID=ai-governance/test
# GOV_AWS_REGION=ap-south-1
